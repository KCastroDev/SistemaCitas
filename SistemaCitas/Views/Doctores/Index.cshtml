@model IEnumerable<SistemaCitas.Models.Doctor>
@{
    ViewData["Title"] = "Doctores";
}

<h1>Doctores</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-primary">Nuevo doctor</a>

    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text" name="buscar" value="@ViewData["Buscar"]"
               class="form-control" placeholder="Buscar por DNI, CMP o nombre..." />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>CMP</th>
                <th>Doctor</th>
                <th>IPRESS</th>
                <th>Especialidad</th>
                <th>Contrato</th>
                <th>Habilitación CMP</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Cmp</td>
                    <td>@d.ApellidoPaterno @d.ApellidoMaterno, @d.Nombres<br /><small class="text-muted">DNI @d.Dni</small></td>
                    <td>@d.Ipress.Nombre</td>
                    <td>@string.Join(", ", d.DoctorEspecialidades.Select(de => de.Especialidad.Nombre))</td>
                    <td>@d.TipoContrato.Nombre</td>
                    <td>
                        <span class="badge @(d.EstadoHabilitacion == "Habilitado" ? "bg-success" : d.EstadoHabilitacion == "No habilitado" ? "bg-danger" : "bg-secondary")">
                            @d.EstadoHabilitacion
                        </span>
                    </td>
                    <td>
                        <span class="badge @(d.Activo ? "bg-success" : "bg-secondary")">@(d.Activo ? "Activo" : "Inactivo")</span>
                    </td>
                    <td class="text-end text-nowrap">
                        <form asp-action="ValidarCmp" asp-route-id="@d.IdDoctor" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Validar CMP</button>
                        </form>
                        <a asp-action="Horarios" asp-route-id="@d.IdDoctor" class="btn btn-sm btn-outline-info">Horarios</a>
                        <form asp-action="CambiarEstado" asp-route-id="@d.IdDoctor" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(d.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(d.Activo ? "Desactivar" : "Reactivar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No hay doctores registrados.</td></tr>
            }
        </tbody>
    </table>
</div>
