@model SistemaCitas.ViewModels.BuscarCuposViewModel
@{
    ViewData["Title"] = "Agendar cita presencial";
    ViewData["Controlador"] = "Admision";
    ViewData["ActionBuscar"] = "Agendar";
}

<h1 class="mb-3">Agendar cita presencial</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fs-5">@TempData["Error"]</div>
}

<partial name="_BuscadorCupos" model="Model" view-data="ViewData" />

<a asp-action="Index" class="btn btn-link mt-3">&larr; Volver a pacientes</a>
