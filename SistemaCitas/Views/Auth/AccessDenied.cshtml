@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container mt-5 pt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-warning shadow-sm">
                <div class="card-body p-5 text-center">

                    <div class="display-1 text-warning mb-3">
                        🔒
                    </div>

                    <h2 class="card-title fw-bold text-dark">Acceso Denegado</h2>

                    <p class="card-text lead text-muted my-4">
                        Lo sentimos, no tienes los permisos necesarios para acceder a esta sección del sistema.
                    </p>

                    <hr class="my-4 opacity-25">

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-action="Login" class="btn btn-primary px-4">
                            Volver al Login
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
                            Ir al Inicio
                        </a>
                    </div>

                </div>
            </div>

            <div class="text-center mt-3">
                <small class="text-muted">Si crees que esto es un error, contacta al administrador.</small>
            </div>
        </div>
    </div>
</div>