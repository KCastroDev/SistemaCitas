@inject Microsoft.AspNetCore.Identity.UserManager<SistemaCitas.Models.Usuario> UserManager
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaCitas</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaCitas.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill text-primary"></i> SistemaCitas Médicas
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @* Antes todos los enlaces del navbar iban en una sola fila que no se envolvia:
                   con varios roles (ej. Administrador) se salia de la pantalla y habia que
                   hacer scroll lateral. Ahora el punto de quiebre es mas grande (lg) y los
                   enlaces de Administrador se agrupan en un menu desplegable. *@
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock me-1"></i>Privacidad</a>
                        </li>
                        @if (User.IsInRole("Admision") || User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admision" asp-action="Index"><i class="bi bi-clipboard2-pulse me-1"></i>Admisión</a>
                            </li>
                        }
                        @if (User.IsInRole("Doctor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Consultorio" asp-action="Index"><i class="bi bi-calendar2-week me-1"></i>Mi agenda</a>
                            </li>
                        }
                        @if (User.IsInRole("Paciente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Citas" asp-action="Index"><i class="bi bi-calendar2-check me-1"></i>Mis citas</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-dark dropdown-toggle" href="#" id="menuAdministracion" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear me-1"></i>Administración
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="menuAdministracion">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Especialidades" asp-action="Index"><i class="bi bi-heart-pulse me-2"></i>Especialidades</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Ipress" asp-action="Index"><i class="bi bi-hospital me-2"></i>IPRESS</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Doctores" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Doctores</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-bar-chart-line me-2"></i>Dashboard</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    @* Zona de sesion: cambia segun si el usuario ya inicio sesion o no *@
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* Mostramos el nombre real del usuario (no el DNI, que ahora es el usuario de inicio de sesion) *@
                            var usuarioActual = await UserManager.GetUserAsync(User);
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="navbar-text text-dark"><i class="bi bi-person-circle me-1"></i>Hola, @(usuarioActual?.Nombres ?? User.Identity.Name)</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-dark"><i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Auth" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Auth" asp-action="Register"><i class="bi bi-person-plus me-1"></i>Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SistemaCitas - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
