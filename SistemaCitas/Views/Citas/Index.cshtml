@model SistemaCitas.ViewModels.MisCitasViewModel
@using SistemaCitas.Models
@{
    ViewData["Title"] = "Mis citas";
    var p = Model.Paciente;
    var color = p.PorcentajeImportancia >= 80 ? "success" : (Model.Bloqueado ? "danger" : "warning");
}

<h1 class="mb-3">Mis citas</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success fs-5">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fs-5">@TempData["Error"]</div>
}

<div class="card border-@color mb-4" style="max-width: 640px;">
    <div class="card-body">
        <h5 class="card-title">@p.Nombres @p.ApellidoPaterno</h5>
        <p class="display-6 mb-1">@p.PorcentajeImportancia.ToString("0.##")%</p>
        <p class="mb-0">@Model.Aviso</p>
    </div>
</div>

@if (!Model.Bloqueado)
{
    <a asp-action="Nueva" class="btn btn-primary btn-lg mb-4">Agendar nueva cita</a>
}

@if (!Model.Citas.Any())
{
    <div class="alert alert-secondary fs-5">Aún no tiene citas registradas.</div>
}
else
{
    <table class="table table-striped fs-5">
        <thead class="table-light">
            <tr>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Doctor</th>
                <th>IPRESS</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Citas)
            {
                var badge = c.Estado switch
                {
                    EstadoCita.Pendiente => "bg-primary",
                    EstadoCita.Asistido => "bg-success",
                    EstadoCita.Falto => "bg-danger",
                    _ => "bg-secondary"
                };
                <tr>
                    <td>@c.FechaCita.ToString("dd/MM/yyyy")</td>
                    <td>@c.HoraCita.ToString("HH:mm")</td>
                    <td>@c.Doctor.ApellidoPaterno @c.Doctor.ApellidoMaterno, @c.Doctor.Nombres</td>
                    <td>@c.Ipress.Nombre</td>
                    <td><span class="badge @badge">@c.Estado</span></td>
                    <td>
                        @if (c.Estado == EstadoCita.Pendiente)
                        {
                            <form asp-action="Cancelar" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Seguro que desea cancelar esta cita?');">
                                <input type="hidden" name="id" value="@c.IdCita" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cancelar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
