@model IEnumerable<SistemaCitas.ViewModels.UsuarioRolViewModel>
@{
    ViewData["Title"] = "Usuarios y roles";
}

<h1><i class="bi bi-people-fill me-2"></i>Usuarios y roles</h1>
<p class="text-muted">Asigne o cambie el rol de acceso de cada usuario del sistema.</p>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text" name="buscar" value="@ViewData["Buscar"]"
               class="form-control" placeholder="Buscar por documento o nombre..." />
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Buscar</button>
    </form>
</div>

<div class="table-responsive">
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Usuario</th>
            <th>Nombre</th>
            <th>Rol actual</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserName</td>
                <td>@item.Nombres</td>
                <td><span class="badge bg-primary">@item.Rol</span></td>
                <td>
                    <span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">
                        @(item.Activo ? "Activo" : "Inactivo")
                    </span>
                </td>
                <td class="text-end">
                    <a asp-action="EditarRol" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                        <i class="bi bi-person-gear"></i> Cambiar rol
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No hay usuarios registrados.</p>
}
