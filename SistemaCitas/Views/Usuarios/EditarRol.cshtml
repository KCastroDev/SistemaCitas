@model SistemaCitas.ViewModels.EditarRolViewModel
@{
    ViewData["Title"] = "Cambiar rol";
}

<h1><i class="bi bi-person-gear me-2"></i>Cambiar rol</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-4">Usuario</dt>
            <dd class="col-sm-8">@Model.UserName</dd>
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombres</dd>
            <dt class="col-sm-4">Rol actual</dt>
            <dd class="col-sm-8"><span class="badge bg-primary">@(Model.RolActual ?? "(sin rol)")</span></dd>
        </dl>

        <form asp-action="EditarRol" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserName" />
            <input type="hidden" asp-for="Nombres" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="NuevoRol" class="form-label"></label>
                <select asp-for="NuevoRol" asp-items="Model.Roles" class="form-select">
                    <option value="">-- Seleccione un rol --</option>
                </select>
                <span asp-validation-for="NuevoRol" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle-fill"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
