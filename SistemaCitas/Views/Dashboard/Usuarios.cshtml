@model SistemaCitas.ViewModels.UsuariosActivosViewModel
@{
    ViewData["Title"] = "Usuarios activos";
    var porRol = Model.Usuarios.GroupBy(u => u.Rol).OrderBy(g => g.Key).ToList();
}

<h1 class="mb-1">Usuarios activos</h1>
<p class="text-muted">Cuentas habilitadas para iniciar sesión (RF-15). Total: <strong>@Model.Usuarios.Count</strong></p>

<div class="d-flex flex-wrap gap-2 mb-3">
    @foreach (var g in porRol)
    {
        <span class="badge bg-primary fs-6">@g.Key: @g.Count()</span>
    }
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Usuarios)
            {
                <tr>
                    <td>@u.Nombre</td>
                    <td>@u.Correo</td>
                    <td><span class="badge bg-secondary">@u.Rol</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-link">&larr; Volver al dashboard</a>
