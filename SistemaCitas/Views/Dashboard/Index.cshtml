@model SistemaCitas.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard y auditoría";
    var total = Math.Max(1, Model.TotalCitas);
    var totalPacientes = Math.Max(1, Model.TotalPacientes);
}

<h1 class="mb-1">Dashboard y auditoría</h1>
<p class="text-muted">Resumen del sistema (RF-15). Los datos se calculan en el momento en que se abre esta pantalla.</p>

@* Tarjetas de totales *@
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card h-100 border-primary"><div class="card-body">
        <div class="text-muted">Pacientes</div><div class="display-6">@Model.TotalPacientes</div>
    </div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100 border-primary"><div class="card-body">
        <div class="text-muted">Doctores</div><div class="display-6">@Model.TotalDoctores</div>
        <small>@Model.DoctoresHabilitados habilitados por CMP</small>
    </div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100 border-primary"><div class="card-body">
        <div class="text-muted">IPRESS activas</div><div class="display-6">@Model.TotalIpress</div>
    </div></div></div>
    <div class="col-6 col-lg-3"><div class="card h-100 border-primary"><div class="card-body">
        <div class="text-muted">Citas de hoy</div><div class="display-6">@Model.CitasHoy</div>
        <small>Total de citas: @Model.TotalCitas</small>
    </div></div></div>
</div>

<div class="row g-4 mb-4">
    @* Citas por estado *@
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h2 class="h5">Citas por estado</h2>
            @{
                var estados = new[]
                {
                    ("Pendientes", Model.CitasPendientes, "bg-primary"),
                    ("Asistieron", Model.CitasAsistidas, "bg-success"),
                    ("Faltaron", Model.CitasFaltas, "bg-danger"),
                    ("Canceladas", Model.CitasCanceladas, "bg-secondary")
                };
            }
            @foreach (var (nombre, cantidad, color) in estados)
            {
                var pct = (int)Math.Round(cantidad * 100.0 / total);
                <div class="mb-2">
                    <div class="d-flex justify-content-between"><span>@nombre</span><strong>@cantidad</strong></div>
                    <div class="progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @color" style="width: @pct%"></div>
                    </div>
                </div>
            }
            <p class="mt-3 mb-0">
                Tasa de inasistencia: <strong>@Model.TasaInasistencia.ToString("0.#")%</strong>
                <small class="text-muted">(de las citas ya resueltas: asistió o faltó)</small>
            </p>
        </div></div>
    </div>

    @* Pacientes por importancia *@
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h2 class="h5">Pacientes por porcentaje de importancia</h2>
            @{
                var niveles = new[]
                {
                    ("Prioridad alta (80% o más)", Model.PacientesPrioridadAlta, "bg-success"),
                    ("Prioridad normal (50% a 79%)", Model.PacientesPrioridadNormal, "bg-warning"),
                    ("Bloqueados (menos de 50%)", Model.PacientesBloqueados, "bg-danger")
                };
            }
            @foreach (var (nombre, cantidad, color) in niveles)
            {
                var pct = (int)Math.Round(cantidad * 100.0 / totalPacientes);
                <div class="mb-2">
                    <div class="d-flex justify-content-between"><span>@nombre</span><strong>@cantidad</strong></div>
                    <div class="progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @color" style="width: @pct%"></div>
                    </div>
                </div>
            }
            <hr />
            <h2 class="h5">Citas por canal <small class="text-muted">(sin canceladas)</small></h2>
            <p class="mb-0">Web: <strong>@Model.CitasWeb</strong> &middot; Presencial: <strong>@Model.CitasPresenciales</strong></p>
        </div></div>
    </div>
</div>

@* Auditoria: cambios de puntaje (RF-11) *@
<h2 class="h4">Auditoría: cambios de puntaje</h2>
<p class="text-muted">Últimos cambios en el porcentaje de importancia de los pacientes, con quién los registró.</p>

@if (!Model.Auditoria.Any())
{
    <div class="alert alert-secondary">Aún no hay cambios de puntaje registrados. Aparecerán cuando se marque una inasistencia ("Faltó").</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Paciente</th>
                    <th>Puntaje</th>
                    <th>Motivo</th>
                    <th>Registrado por</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.Auditoria)
                {
                    <tr>
                        <td>@h.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@h.Paciente.ApellidoPaterno @h.Paciente.ApellidoMaterno, @h.Paciente.Nombres<br /><small class="text-muted">DNI @h.Paciente.Dni</small></td>
                        <td>@h.PuntajeAnterior.ToString("0.##")% &rarr; <strong>@h.PuntajeNuevo.ToString("0.##")%</strong></td>
                        <td>@h.Motivo</td>
                        <td>@(h.RegistradoPor?.Email ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
