@model IEnumerable<SistemaCitas.Models.Especialidad>
@{
    ViewData["Title"] = "Especialidades";
}

<h1>Especialidades</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-primary">Nueva especialidad</a>

    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text" name="buscar" value="@ViewData["Buscar"]"
               class="form-control" placeholder="Buscar especialidad..." />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </form>
</div>

<table class="table table-striped table-hover">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>@Html.DisplayNameFor(m => m.Nombre)</th>
            <th>Estado</th> <!-- Nueva cabecera -->
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdEspecialidad</td>
                <td>@item.Nombre</td>
                <!-- Nueva columna de estado -->
                <td>
                    <span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">
                        @(item.Activo ? "Activa" : "Inactiva")
                    </span>
                </td>
                <!-- Columna de acciones modificada -->
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.IdEspecialidad" class="btn btn-sm btn-outline-info">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.IdEspecialidad" class="btn btn-sm btn-outline-warning">Editar</a>
                    <form asp-action="CambiarEstado" asp-route-id="@item.IdEspecialidad" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-success")">
                            @(item.Activo ? "Desactivar" : "Reactivar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No hay especialidades registradas.</p>
}