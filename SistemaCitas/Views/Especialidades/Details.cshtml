@model SistemaCitas.Models.Especialidad
@{
    ViewData["Title"] = "Detalle de especialidad";
}

<h1>Detalle de especialidad</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Codigo</dt>
    <dd class="col-sm-9">@Model.IdEspecialidad</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdEspecialidad" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
